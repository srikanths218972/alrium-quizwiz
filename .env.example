APP_NAME="ålrium - QuizWiz"
APP_ENV=local
AUTH_MODE=

QA_COMPOSE_PROJECT=qa-alrium
POSTGRES_USER=qa_admin
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=daily_qa
QA_DB_PORT=5433

DATABASE_URL=postgresql://qa_admin:replace-with-a-long-random-password@127.0.0.1:5433/daily_qa

SOURCE_DATABASE_URL=postgresql://qa_admin:replace-with-a-long-random-password@127.0.0.1:5433/daily_qa
TARGET_ADMIN_URL=postgresql://postgres:replace-with-local-admin-password@127.0.0.1:5432/postgres
TARGET_DATABASE=daily_qa_local
TARGET_OWNER=qa_app_owner
PG_BIN=

API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=5173
ALLOWED_ORIGINS=
API_DOCS_PUBLIC=false

EMAIL_TOKEN_SECRET=
ADMIN_API_KEY=
EMAIL_ALLOWED_DOMAINS=
EMAIL_TOKEN_TTL_MINUTES=60
EMAIL_LOGIN_RATE_PER_MINUTE=10

ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
ENTRA_REQUIRED_SCOPE=Quiz.Participate
ENTRA_ALLOWED_CLIENT_IDS=
ENTRA_ADMIN_ROLE=Quiz.Admin
ENTRA_PARTICIPANT_ROLE=
ENTRA_REJECT_GUESTS=true
ENTRA_SPA_CLIENT_ID=
ENTRA_API_SCOPE=
WEB_REDIRECT_URI=http://localhost:5173/

