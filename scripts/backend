#!/usr/bin/env bash
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/env.sh"
port_free "${API_PORT:-8000}" API_PORT || exit 1
cd "$ROOT/backend"
uv run --frozen python -m qa_api.config
exec uv run --frozen uvicorn qa_api.app:create_app --factory --host "${API_HOST:-127.0.0.1}" --port "${API_PORT:-8000}" --reload --reload-dir qa_api
