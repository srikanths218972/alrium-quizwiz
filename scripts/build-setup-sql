#!/usr/bin/env python3
"""Builds db/setup.sql: the whole schema for a NEW, empty PostgreSQL database in one psql file.

It contains db/migrations/*.sql in order, each in its own transaction together with its
schema_migrations row (same version, filename and SHA-256 checksum that make migrate records),
so a database created from it is identical to one built by make migrate, and later migrations
apply normally. Regenerate after adding a migration:  scripts/build-setup-sql
"""
import hashlib
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
MIGRATIONS = ROOT / "db" / "migrations"
OUT = ROOT / "db" / "setup.sql"
NAME = re.compile(r"^[0-9]{4}_[a-z0-9_]+\.sql$")

files = sorted(MIGRATIONS.glob("*.sql"))
bad = [f.name for f in files if not NAME.match(f.name)]
if bad:
    sys.exit(f"error: invalid migration filenames: {', '.join(bad)}")

parts = [f"""-- ålrium - QuizWiz: complete database schema for a NEW, empty PostgreSQL database.
-- GENERATED by scripts/build-setup-sql from db/migrations ({files[0].name[:4]} to {files[-1].name[:4]}). Do not edit by hand.
--
-- Run as the role that will own the tables, connected to the new database:
--   psql "postgresql://<owner>:<password>@<host>:5432/<database>" -v ON_ERROR_STOP=1 -f db/setup.sql
--
-- Creates the tables, functions, triggers and constraints, records each migration in
-- schema_migrations (so `make migrate` later finds nothing to do), and sets the database time
-- zone to Asia/Kolkata. Inserts no questions, responses or users. Refuses to run on a database
-- that already has these tables. Requires PostgreSQL 13 or later (tested with 18).

\\set ON_ERROR_STOP on
SET client_min_messages = warning;

DO $$
BEGIN
    IF to_regclass('public.questions') IS NOT NULL OR to_regclass('public.schema_migrations') IS NOT NULL THEN
        RAISE EXCEPTION 'this database already has the schema; use make migrate to upgrade it instead of db/setup.sql';
    END IF;
END $$;

-- Business dates and timestamps are Asia/Kolkata. Applies to new sessions of this database.
DO $$
BEGIN
    EXECUTE format('ALTER DATABASE %I SET timezone = %L', current_database(), 'Asia/Kolkata');
END $$;
SET timezone = 'Asia/Kolkata';

CREATE TABLE schema_migrations (
    version    text        PRIMARY KEY,
    filename   text        NOT NULL,
    checksum   text        NOT NULL,
    applied_at timestamptz NOT NULL DEFAULT now()
);
"""]
for f in files:
    data = f.read_bytes()
    checksum = hashlib.sha256(data).hexdigest()
    parts.append(f"""
-- ============================================================================================
-- {f.name}
-- ============================================================================================
BEGIN;

{data.decode().rstrip()}

INSERT INTO schema_migrations (version, filename, checksum) VALUES ('{f.name[:4]}', '{f.name}', '{checksum}');
COMMIT;
""")
parts.append("\n\\echo 'schema ready: ' :DBNAME\n")
OUT.write_text("".join(parts))
print(f"wrote {OUT.relative_to(ROOT)} ({len(files)} migrations)")
