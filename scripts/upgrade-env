#!/usr/bin/env python3
"""Upgrades .env to the current sign-in settings (entra | email).

Explicit and reversible: the current file is copied to backups/ first, every changed key is
printed (names and non-secret values only), and no secret value is ever printed.
    scripts/upgrade-env            show what would change
    scripts/upgrade-env --apply    write the change

- AUTH_MODE=none / local-test / demo are removed modes. They become AUTH_MODE=email, because
  Microsoft sign-in is not configured in those files (an explicit mode avoids guessing from
  placeholder ENTRA_* values).
- LOCAL_TEST_* and DEMO_* keys are removed.
- EMAIL_TOKEN_SECRET and ADMIN_API_KEY are generated (32 random bytes each) when missing.
  Read ADMIN_API_KEY from .env yourself when you need it; it is not shown here.
- EMAIL_ALLOWED_DOMAINS is set to alrium.com when absent (a convenience filter, not verification).
"""
import re
import secrets
import shutil
import sys
from datetime import datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
ENV = ROOT / ".env"
SECRET = re.compile(r"PASSWORD|SECRET|KEY|DATABASE_URL")

lines = ENV.read_text().splitlines()
values = {m.group(1): m.group(2) for line in lines if (m := re.match(r"^([A-Z_][A-Z0-9_]*)=(.*)$", line))}
changes: dict[str, str | None] = {}


def change(key: str, value: str | None) -> None:
    if values.get(key) != value:
        changes[key] = value


if values.get("AUTH_MODE", "").strip().lower() in ("none", "local-test", "demo"):
    change("AUTH_MODE", "email")
for key in values:
    if key.startswith(("LOCAL_TEST_", "DEMO_")):
        change(key, None)
if len(values.get("EMAIL_TOKEN_SECRET", "")) < 32:
    change("EMAIL_TOKEN_SECRET", secrets.token_hex(32))
if len(values.get("ADMIN_API_KEY", "")) < 32:
    change("ADMIN_API_KEY", secrets.token_hex(32))
if "EMAIL_ALLOWED_DOMAINS" not in values:
    change("EMAIL_ALLOWED_DOMAINS", "alrium.com")

if not changes:
    print(".env is already up to date")
    sys.exit(0)
for k, v in changes.items():
    old = "<unset>" if k not in values else ("<secret>" if SECRET.search(k) else values[k])
    new = "<removed>" if v is None else ("<generated, secret>" if SECRET.search(k) else v)
    print(f"  {k}: {old} -> {new}")
if "--apply" not in sys.argv:
    print("dry run; re-run with --apply to write .env (a backup is kept in backups/)")
    sys.exit(0)

backup = ROOT / "backups" / f"env-{datetime.now():%Y%m%dT%H%M%S}.bak"
backup.parent.mkdir(exist_ok=True)
shutil.copy2(ENV, backup)
backup.chmod(0o600)
out, seen = [], set()
for line in lines:
    m = re.match(r"^([A-Z_][A-Z0-9_]*)=", line)
    if m and m.group(1) in changes:
        seen.add(m.group(1))
        if changes[m.group(1)] is not None:
            out.append(f"{m.group(1)}={changes[m.group(1)]}")
        continue
    out.append(line)
for k, v in changes.items():
    if k not in seen and v is not None:
        out.append(f"{k}={v}")
ENV.write_text("\n".join(out) + "\n")
ENV.chmod(0o600)
print(f"wrote .env (previous version: {backup.relative_to(ROOT)})")
